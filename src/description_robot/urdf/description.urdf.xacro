<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="pendulum_stabilization">


    <!-- <xacro:include filename="include.xacro" /> -->

    <!-- include              -->
    <!--  -->
    <!--  -->
    <material name="white">
        <color rgba="1 1 1 1"/>
    </material>

    <material name="orange">
        <color rgba="1 0.3 0.1 1"/>
    </material>

    <material name="blue">
        <color rgba="0.2 0.2 1 1"/>
    </material>

    <material name="green">
        <color rgba="0.2 1 0.2 1"/>
    </material>

    <xacro:macro name="inertial_cuboid" params="mass width height depth *origin">
        <inertial>
            <xacro:insert_block name="origin"/>
            <mass value="${mass}"/>
            <inertia ixx="${(1/12) * mass * (height*height + depth*depth)}" ixy="0.0" ixz="0.0"
                    iyy="${(1/12) * mass * (width*width + depth*depth)}" iyz="0.0"
                    izz="${(1/12) * mass * (width*width + height*height)}" /> 
        </inertial>
    </xacro:macro>

    <xacro:macro name="inertial_slender" params="mass length *origin">
        <inertial>
            <xacro:insert_block name="origin"/>
            <mass value="${mass}"/>
            <inertia ixx="${(1/12) * mass * (length*length)}" ixy="0.0" ixz="0.0"
                    iyy="${(1/12) * mass * (length*length)}" iyz="0.0"
                    izz="${(1/12) * mass * (0.01*0.01)}" /> 
        </inertial>
    </xacro:macro>

    <xacro:macro name="inertial_cylinder" params="mass radius height *origin">
        <inertial>
            <xacro:insert_block name="origin"/>
            <mass value="${mass}"/>
            <inertia ixx="${(1/12) * mass * (3*radius*radius + height*height)}" ixy="0.0" ixz="0.0"
                    iyy="${(1/12) * mass * (3*radius*radius + height*height)}" iyz="0.0"
                    izz="${(1/2) * mass * (radius*radius)}" /> 
        </inertial>
    </xacro:macro>
    <!-- include                        -->
    <!--  -->
    <!--  -->


    
    <link name="world" />

    <joint name="joint_base_to_column1" type="fixed">
        <parent link="world"/>
        <child link="link_column1"/>
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
    </joint>

    <link name="link_column1">
        <visual>
            <origin xyz="0.02 0.02 0.5" rpy="0.0 0.0 0.0"/>
            <geometry>
                <box size="0.04 0.04 1"/>
            </geometry>
        </visual>

        <collision>
            <origin xyz="0.02 0.02 0.5" rpy="0.0 0.0 0.0"/>
            <geometry>
                <box size="0.04 0.04 1"/>
            </geometry>
        </collision>

        <xacro:inertial_cuboid mass="1" width="0.04" height="0.04" depth="1">
            <origin xyz="0.02 0.02 0.5" rpy="0 0 0"/>
        </xacro:inertial_cuboid>

    </link>

    <joint name="joint_connect_sliding_bar1" type="fixed">
        <parent link="link_column1"/>
        <child link="link_sliding_bar"/> 
        <origin xyz="0.02 0 1"/>
    </joint>  

    <link name="link_sliding_bar">
        <visual>
            <geometry>
                <box size="0.04 0.8 0.04"/>
            </geometry>
            <origin xyz="0 0.4 0.02" rpy="0 0.0 0.0"/>
        </visual>
        <collision>
            <geometry>
                <box size="0.04 0.8 0.04"/>
            </geometry>
            <origin xyz="0 0.4 0.02" rpy="0 0.0 0.0"/>
        </collision>
        <xacro:inertial_cuboid mass="1" width="0.04" height="0.8" depth="0.04">
            <origin xyz="0 0.4 0.02" rpy="0 0.0 0.0"/>
        </xacro:inertial_cuboid>
    </link>

    <joint name="joint_bar2_to_base" type="fixed">
        <parent link="world"/>
        <child link="link_column2"/>
        <origin xyz="0 0.78 0"/>
    </joint>

    <link name="link_column2">
        <visual>
            <geometry>
                <box size="0.04 0.04 1"/>
            </geometry>
            <origin xyz="0.02 0 0.5" rpy="0.0 0.0 0.0"/>  
        </visual>
        <collision>
            <geometry>
                <box size="0.04 0.04 1"/>
            </geometry>
            <origin xyz="0.02 0 0.5" rpy="0.0 0.0 0.0"/>   
        </collision>

        <xacro:inertial_cuboid mass="1" width="0.04" height="0.04" depth="1">
            <origin xyz="0.02 0 0.5" rpy="0.0 0.0 0.0"/>   
        </xacro:inertial_cuboid>
    </link>

    <joint name="joint_column1_motor" type="fixed">
        <parent link="link_column1"/>
        <child link="link_motor"/>
        <origin xyz="0.02 0.02 1.04"/>
    </joint>  

    <!-- right now just for pulley is not move, if want to pulley moving, separate it -->
    <link name="link_motor">
        <visual> <!-- motor body-->
            <geometry>
                <box size="0.04 0.04 0.05"/>
            </geometry>
            <origin xyz="0 0 0.02" rpy="0.0 0.0 0.0"/>
            <material name="green"/>
        </visual>
        <visual> <!-- pulley-->
            <geometry>
                <cylinder radius="0.01" length="0.01"/>
            </geometry>
            <origin xyz="-0.02 0.0 0.02" rpy="0.0 -1.57075 0.0"/>
            <material name="green"/>
        </visual>

        <collision>
            <geometry>
                <box size="0.04 0.04 0.05"/>
            </geometry>
            <origin xyz="0 0 0.02" rpy="0.0 0.0 0.0"/>   
        </collision>
        <collision>
            <geometry>
                <cylinder radius="0.01" length="0.01"/>
            </geometry>
            <origin xyz="-0.02 0.0 0.02" rpy="0.0 -1.57075 0.0"/>   
        </collision>

        <xacro:inertial_cuboid mass="0.2" width="0.04" height="0.04" depth="0.05">
            <origin xyz="0 0 0.02" rpy="0.0 0.0 0.0"/> 
        </xacro:inertial_cuboid>
    </link>

    <joint name="joint_encorder_motor" type="prismatic">
        <parent link="link_motor"/>
        <child link="link_encorder"/>
        <origin xyz="0 0.4 0.02"/>
        <axis xyz="0.0 1 0.0"/>
        <limit lower="-0.35" upper="0.3" effort="100.0" velocity="0.2"/>
        <dynamics damping="0.01" friction="0.05"/>
    </joint>

    <link name="link_encorder">
        <visual> <!-- body-->
            <geometry>
                <box size="0.04 0.04 0.04"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0.0 0.0 0.0"/>  
            <material name="blue" />
        </visual>

        <visual name="pulley_of_encoder"> 
            <geometry>
                <cylinder radius="0.01" length="0.01"/>
            </geometry>
            <origin xyz="-0.03 0 0" rpy="0.0 -1.57075 0.0"/>
            <material name="blue" />
        </visual>

        <visual name="shaft_connect_pendulum"> 
            <geometry>
                <cylinder radius="0.005" length="0.01"/>
            </geometry>
            <origin xyz="0.01 0 0" rpy="0.0 1.57075 0.0"/>
            <material name="blue" />
        </visual>

        <collision>
            <geometry>
                <box size="0.04 0.04 0.04"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0.0 0.0 0.0"/>  
        </collision>
        <collision>
            <geometry>
                <cylinder radius="0.01" length="0.01"/>
            </geometry>
            <origin xyz="-0.03 0 0" rpy="0.0 -1.57075 0.0"/>  
        </collision>
        <collision>
            <geometry>
                <cylinder radius="0.005" length="0.01"/>
            </geometry>
            <origin xyz="0.01 0 0" rpy="0.0 1.57075 0.0"/>  
        </collision>

        <xacro:inertial_cuboid mass="0.2" width="0.04" height="0.04" depth="0.04">
            <origin xyz="0 0 0.02" rpy="0.0 0.0 0.0"/> 
        </xacro:inertial_cuboid>
    </link>

    <joint name="joint_encorder_pendulum" type="continuous">
        <parent link="link_encorder"/>
        <child link="link_pendulum"/>
        <origin xyz="0.03 0 0" rpy="0.01 0.0 0.0"/>
        <axis xyz="1 0.0 0.0"/>
        <dynamics damping="0.0001" friction="0.002"/>
    </joint>

    <link name="link_pendulum">
        <visual>
            <geometry>
                <box size="0.02 0.05 0.4"/>
            </geometry>
            <origin xyz="0.01 0 0.2" rpy="0.0 0.0 0.0"/>
            <material name="green" />
        </visual>

        <collision>
            <geometry>
                <box size="0.02 0.05 0.4"/>
            </geometry>
            <origin xyz="0.01 0 0.2" rpy="0.0 0.0 0.0"/>
        </collision>

        <xacro:inertial_slender mass="0.3" length="0.4">
            <origin xyz="0.01 0 0.2" rpy="0.0 0.0 0.0"/> 
        </xacro:inertial_slender>
    </link>

<!-- Gazebo -->
 <!--  -->
<!--  -->

    <gazebo reference="link_column1">
        <material>Gazebo/Green</material>
    </gazebo>

    <gazebo reference="link_sliding_bar">
        <material>Gazebo/Blue</material>
    </gazebo>

    <gazebo reference="link_column2">
        <material>Gazebo/Red</material>
    </gazebo>

    <gazebo reference="link_motor">
        <material>Gazebo/Green</material>
    </gazebo>
    
    <gazebo reference="link_encorder">
        <material>Gazebo/Blue</material>
    </gazebo>
    
    <gazebo reference="link_pendulum">
        <material>Gazebo/Red</material>
    </gazebo>
    
    <!-- create plugin           -->
    <!-- <gazebo>
        <plugin
            filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
            <topic>joint_states</topic>
            <joint_name>joint_encorder_motor</joint_name>
            <joint_name>joint_encorder_pendulum</joint_name>
        </plugin>
    </gazebo> -->

    <gazebo>
        <plugin filename="libgz_ros2_control-system.so" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
            <parameters>$(find description_robot)/config/cart_controller.yaml</parameters>
        </plugin>
    </gazebo>

    <!-- https://control.ros.org/rolling/doc/gz_ros2_control/doc/index.html -->
    <ros2_control name="GazeboSimSystem" type="system">
        <hardware>
            <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        </hardware>
        <joint name="joint_encorder_motor">
            <command_interface name="effort">
                <param name="min">-100</param>
                <param name="max">100</param>
            </command_interface>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>

        <joint name="joint_encorder_pendulum">
            <state_interface name="position"/>
            <state_interface name="velocity"/>
            <state_interface name="effort"/>
        </joint>
    </ros2_control>

</robot>